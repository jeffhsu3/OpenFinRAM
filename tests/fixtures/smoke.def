VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN ctrl_decode_smoke ;
UNITS DISTANCEMICRONS 1000 ;
DIEAREA ( 0 0 ) ( 21600 21600 ) ;
ROW ROW_0 asap7sc7p5t 0 1080 N DO 40 BY 1 STEP 540 0 ;
TRACKS M1 X 180 DO 60 STEP 360 LAYER M1 ;
COMPONENTS 2 ;
    - u_inv_0 INVx1_ASAP7_75t_R + PLACED ( 2160 1080 ) N ;
    - u_inv_1 INVx1_ASAP7_75t_R + PLACED ( 3240 1080 ) N ;
END COMPONENTS
PINS 2 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + LAYER M4 ( 0 10800 ) ( 480 11280 ) ;
    - wlt0 + NET wlt0 + DIRECTION OUTPUT + USE SIGNAL
      + LAYER M5 ( 21120 10800 ) ( 21600 11280 ) ;
END PINS
NETS 2 ;
    - clk ( PIN clk ) ( u_inv_0 A ) ;
    - wlt0 ( PIN wlt0 ) ( u_inv_0 Y ) ;
END NETS
END DESIGN
